{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "strictNullChecks": true,
    // Read by dependency-cruiser, which takes one tsconfig for the whole repository. It
    // mirrors each app's own alias so those imports resolve there; each app's compiler still
    // uses its own tsconfig. Change one and change the other.
    "paths": {
      "@/*": ["./apps/web/*"],
      "@app/*": ["./apps/api/src/*"],
      "@test/*": ["./apps/api/test/*"]
    }
  }
}
