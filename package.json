{
  "name": "thrive",
  "version": "0.0.0",
  "private": true,
  "description": "Thrive \u2014 an employee feedback platform",
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "check": "bun run check:style && bun run check:types && bun run check:arch",
    "check:style": "biome check --error-on-warnings .",
    "check:types": "turbo run check-types",
    "check:arch": "bun --bun depcruise apps packages --config .dependency-cruiser.cjs --output-type err && bun scripts/verify-arch-fixtures.mjs && turbo run check-arch"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@repo/biome-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "dependency-cruiser": "18.4.0",
    "turbo": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@biomejs/biome": "2.5.14",
      "@types/node": "^22.19.3",
      "@types/react": "19.1.0",
      "@types/react-dom": "19.1.1",
      "jest": "30.4.2",
      "next": "16.3.0",
      "react": "^19.1.0",
      "react-dom": "^19.1.0",
      "turbo": "2.10.9",
      "typescript": "5.8.2",
      "uuid": "^11.1.1",
      "vitest": "3.2.7",
      "zod": "^4.6.5"
    }
  }
}
