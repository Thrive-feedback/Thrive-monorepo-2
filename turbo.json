{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["API_BASE_URL", "NODE_ENV", "PORT"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"],
      "env": ["API_BASE_URL", "NODE_ENV", "PORT"]
    },
    "contract:generate": {
      "cache": false
    },
    "lint": {},
    "test": {
      "env": ["API_BASE_URL", "NODE_ENV", "PORT"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV", "PORT"]
    },
    "test:bdd": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV", "PORT"]
    },
    "check-arch": {}
  }
}
