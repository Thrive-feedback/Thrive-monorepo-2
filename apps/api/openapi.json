          "identity"
        ]
      },
      "delete": {
        "operationId": "SessionController_signOut",
        "parameters": [
          {
            "name": "cookie",
            "required": false,
            "in": "header",
            "description": "The browser's cookie header, forwarded by the web server.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Sign out of the current session",
