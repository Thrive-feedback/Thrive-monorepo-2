{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto_Output"
                }
              }
            }
          }
        },
        "summary": "Report that the API is up",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/sessions/google": {
      "post": {
        "operationId": "SessionController_startGoogleSignIn",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartGoogleSignInResponseDto_Output"
                }
              }
            }
          }
        },
        "summary": "Start signing in with Google",
        "tags": [
          "sessions"
        ]
      }
    },
    "/v1/sessions/current": {
      "get": {
        "operationId": "SessionController_getCurrentSession",
        "parameters": [
          {
            "name": "cookie",
            "required": false,
            "in": "header",
            "description": "The browser's cookie header, forwarded by the web server.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCurrentSessionResponseDto_Output"
                }
              }
            }
          }
        },
        "summary": "Read who the caller is signed in as, without changing anything",
        "tags": [
          "sessions"
        ]
      },
      "delete": {
        "operationId": "SessionController_signOut",
        "parameters": [
          {
            "name": "cookie",
            "required": false,
            "in": "header",
            "description": "The browser's cookie header, forwarded by the web server.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Sign out of the current session",
        "tags": [
          "sessions"
        ]
      }
    },
    "/v1/sessions/current/refresh": {
      "post": {
        "operationId": "SessionController_refreshSession",
        "parameters": [
          {
            "name": "cookie",
            "required": false,
            "in": "header",
            "description": "The browser's cookie header, forwarded by the web server.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Push the current session forward and reissue its cookie",
        "tags": [
          "sessions"
        ]
      }
    }
  },
  "info": {
    "title": "Thrive API",
    "description": "Thrive — an employee feedback platform.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponseDto_Output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "StartGoogleSignInResponseDto_Output": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "GetCurrentSessionResponseDto_Output": {
        "type": "object",
        "properties": {
          "account": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "email",
              "name"
            ],
            "additionalProperties": false,
            "nullable": true
          },
          "needsRefresh": {
            "type": "boolean"
          }
        },
        "required": [
          "account",
          "needsRefresh"
        ],
        "additionalProperties": false
      }
    }
  }
}
