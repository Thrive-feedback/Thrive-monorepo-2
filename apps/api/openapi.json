            "description": "The browser's cookie header, forwarded by the web server.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Push the current session forward and reissue its cookie",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/profiles": {
      "post": {
        "operationId": "ProfileController_createProfile",
        "parameters": [
          {
            "name": "cookie",
            "in": "header",
            "description": "The browser's cookie header, forwarded by the web server.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProfileRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateProfileResponseDto_Output"
                }
              }
            }
          },
          "400": {
            "description": "REQUEST_INVALID, FULL_NAME_EMPTY, FULL_NAME_TOO_LONG, DISPLAY_NAME_EMPTY or DISPLAY_NAME_TOO_LONG"
          },
          "401": {
            "description": "NOT_SIGNED_IN"
          },
          "409": {
            "description": "PROFILE_ALREADY_EXISTS, or PROFILE_SLUG_TAKEN after retries"
          }
        },
        "summary": "Create the caller's Profile",
        "tags": [
          "identity"
        ]
      }
    },
    "/v1/workspaces": {
      "post": {
        "operationId": "WorkspaceController_createWorkspace",
        "parameters": [
          {
            "name": "cookie",
            "required": false,
            "in": "header",
            "description": "The browser's cookie header, forwarded by the web server.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorkspaceRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateWorkspaceResponseDto_Output"
                }
              }
            }
          },
          "400": {
            "description": "REQUEST_INVALID, WORKSPACE_NAME_EMPTY or WORKSPACE_NAME_TOO_LONG"
          },
          "401": {
            "description": "NOT_SIGNED_IN"
          },
          "409": {
            "description": "PROFILE_REQUIRED or ALREADY_IN_A_WORKSPACE"
          }
        },
        "summary": "Create a Workspace, with the caller as its Owner",
        "tags": [
          "workspace"
        ]
      }
    },
    "/v1/members/mine": {
      "get": {
        "operationId": "MemberController_listMyMemberships",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 9007199254740991,
              "default": 1,
              "type": "integer"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "integer"
            }
          },
          {
            "name": "cookie",
            "in": "header",
            "description": "The browser's cookie header, forwarded by the web server.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListMyMembershipsResponseDto_Output"
                }
              }
            }
          },
          "401": {
            "description": "NOT_SIGNED_IN"
          }
        },
        "summary": "List the Workspaces the caller is a Member of, and their Role",
        "tags": [
          "workspace"
        ]
      }
    },
    "/v1/workspaces/{workspaceId}/members": {
      "get": {
        "operationId": "WorkspaceMemberController_listWorkspaceMembers",
        "parameters": [
          {
            "name": "workspaceId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 9007199254740991,
              "default": 1,
              "type": "integer"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "integer"
            }
          },
          {
            "name": "cookie",
            "in": "header",
            "description": "The browser's cookie header, forwarded by the web server.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListWorkspaceMembersResponseDto_Output"
                }
              }
            }
          },
          "401": {
            "description": "NOT_SIGNED_IN"
          },
          "404": {
            "description": "WORKSPACE_NOT_FOUND"
          }
        },
        "summary": "List the Members of a Workspace and their Roles",
        "tags": [
          "workspace"
        ]
      }
    },
    "/v1/workspaces/{workspaceId}/invitations": {
      "get": {
        "operationId": "InvitationController_listWorkspaceInvitations",
        "parameters": [
          {
            "name": "workspaceId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 9007199254740991,
              "default": 1,
              "type": "integer"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "integer"
            }
          },
          {
            "name": "cookie",
            "in": "header",
            "description": "The browser's cookie header, forwarded by the web server.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListWorkspaceInvitationsResponseDto_Output"
                }
              }
            }
          },
          "401": {
            "description": "NOT_SIGNED_IN"
          },
          "403": {
            "description": "NOT_ALLOWED_TO_SEE_INVITATIONS"
          },
          "404": {
            "description": "WORKSPACE_NOT_FOUND"
          }
        },
        "summary": "List the Invitations of a Workspace still waiting on someone, pending or expired",
        "tags": [
          "workspace"
        ]
      },
      "post": {
        "operationId": "InvitationController_sendInvitations",
        "parameters": [
          {
            "name": "cookie",
            "required": false,
            "in": "header",
            "description": "The browser's cookie header, forwarded by the web server.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workspaceId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendInvitationsRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendInvitationsResponseDto_Output"
                }
              }
            }
          },
          "400": {
            "description": "REQUEST_INVALID, NO_ADDRESSES_TO_INVITE or TOO_MANY_INVITATIONS"
          },
          "401": {
            "description": "NOT_SIGNED_IN"
          },
          "403": {
            "description": "NOT_ALLOWED_TO_INVITE"
          },
          "404": {
            "description": "WORKSPACE_NOT_FOUND"
          }
        },
        "summary": "Invite several people to a Workspace by email, at most 10 at a time",
        "tags": [
          "workspace"
        ]
      }
    },
    "/v1/workspaces/{workspaceId}/invitations/{invitationId}/revoke": {
      "post": {
        "operationId": "InvitationController_revokeInvitation",
        "parameters": [
          {
            "name": "cookie",
            "required": false,
            "in": "header",
            "description": "The browser's cookie header, forwarded by the web server.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workspaceId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          },
          {
            "name": "invitationId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "401": {
            "description": "NOT_SIGNED_IN"
          },
          "403": {
            "description": "NOT_ALLOWED_TO_REVOKE_INVITATIONS"
          },
          "404": {
            "description": "WORKSPACE_NOT_FOUND or INVITATION_NOT_FOUND"
          },
          "409": {
            "description": "INVITATION_ALREADY_ACCEPTED or INVITATION_REVOKED"
          }
        },
        "summary": "Revoke an open Invitation to a Workspace, so its link stops working",
        "tags": [
          "workspace"
        ]
      }
    },
    "/v1/invitations/{invitationId}": {
      "get": {
        "operationId": "InvitationLinkController_getInvitation",
        "parameters": [
          {
            "name": "invitationId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetInvitationResponseDto_Output"
                }
              }
            }
          },
          "404": {
            "description": "INVITATION_NOT_FOUND"
          }
        },
        "summary": "Read an Invitation as the person holding its link sees it, signed in or not",
        "tags": [
          "workspace"
        ]
      }
    },
    "/v1/invitations/{invitationId}/accept": {
      "post": {
        "operationId": "InvitationLinkController_acceptInvitation",
        "parameters": [
          {
            "name": "cookie",
            "required": false,
            "in": "header",
            "description": "The browser's cookie header, forwarded by the web server.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "invitationId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Accepted, or already a Member there"
          },
          "401": {
            "description": "NOT_SIGNED_IN"
          },
          "403": {
            "description": "INVITATION_NOT_FOR_YOU"
          },
          "404": {
            "description": "INVITATION_NOT_FOUND"
          },
          "409": {
            "description": "INVITATION_EXPIRED, INVITATION_REVOKED, INVITATION_ALREADY_ACCEPTED or ALREADY_IN_A_WORKSPACE"
          }
        },
        "summary": "Accept an Invitation, joining its Workspace; repeating it once in changes nothing",
        "tags": [
          "workspace"
        ]
      }
    }
  },
  "info": {
    "title": "Thrive API",
    "description": "Thrive — an employee feedback platform.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "identity",
      "description": "Who is signed in, their session and their Profile."
    },
    {
      "name": "workspace",
      "description": "Workspaces, their Members and their Invitations."
    },
    {
      "name": "app",
      "description": "The application itself, such as its health."
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponseDto_Output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "StartGoogleSignInRequestDto": {
        "type": "object",
        "properties": {
          "invitationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "additionalProperties": false
      },
      "StartGoogleSignInResponseDto_Output": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "GetCurrentSessionResponseDto_Output": {
        "type": "object",
        "properties": {
          "account": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              "name": {
                "type": "string"
              },
              "profile": {
                "type": "object",
                "properties": {
                  "fullName": {
                    "type": "string"
                  },
                  "displayName": {
                    "type": "string"
                  },
                  "slug": {
                    "type": "string"
                  }
                },
                "required": [
                  "fullName",
                  "displayName",
                  "slug"
                ],
                "additionalProperties": false,
                "nullable": true
              }
            },
            "required": [
              "email",
              "name",
              "profile"
            ],
            "additionalProperties": false,
            "nullable": true
          },
          "needsRefresh": {
            "type": "boolean"
          }
        },
        "required": [
          "account",
          "needsRefresh"
        ],
        "additionalProperties": false
      },
      "CreateProfileRequestDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": [
          "fullName",
          "displayName"
        ],
        "additionalProperties": false
      },
      "CreateProfileResponseDto_Output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "CreateWorkspaceRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "teamSize": {
            "type": "string",
            "enum": [
              "JUST_ME",
              "FROM_2_TO_10",
              "FROM_11_TO_50",
              "OVER_50",
              null
            ],
            "nullable": true
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "CreateWorkspaceResponseDto_Output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "ListMyMembershipsResponseDto_Output": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "workspace": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ],
                  "additionalProperties": false
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "OWNER",
                    "ADMIN",
                    "MEMBER"
                  ]
                }
              },
              "required": [
                "workspace",
                "role"
              ],
              "additionalProperties": false
            }
          },
          "total": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "page": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "pageSize": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "pageSize"
        ],
        "additionalProperties": false
      },
      "ListWorkspaceMembersResponseDto_Output": {
        "type": "object",
        "properties": {
