generator client {
  provider     = "prisma-client"
  output       = "../src/infrastructure/database/generated"
  runtime      = "bun"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       Profile?

  members     Member[]
  invitations Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// An Account's personal details shown to others. Created by "Introduce yourself"; an Account
/// without one has not finished registering.
model Profile {
  id          String   @id
  accountId   String
  account     User     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fullName    String
  displayName String
  slug        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([accountId])
  @@unique([slug])
  @@map("profile")
}

// Workspace's tables, written by Better Auth's organization plugin (ADR 0032) under the
// glossary's names: its `organization` is a Workspace and its `organizationId` is
// `workspaceId`. `member.userId` is a Thrive Account, which is Better Auth's `user.id`, never
// an `account` row. The domain calls it `accountId`; the mapper translates.

enum TeamSize {
  JUST_ME
  FROM_2_TO_10
  FROM_11_TO_50
  OVER_50
}

model Workspace {
  id          String       @id
  name        String
  /// Opaque and unique, because the plugin requires one. Never shown: a Workspace has no slug
  /// in the glossary.
  slug        String
  logo        String?
  metadata    String?
  teamSize    TeamSize?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     Member[]
  invitations Invitation[]

  @@unique([slug])
  @@map("workspace")
}

// No unique index on `userId` alone: one Account can be a Member of many Workspaces
// (brain ADR-0034).
model Member {
  id            String    @id
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The plugin's lowercase role name, e.g. `admin`. The mapper turns it into a Role.
  role          String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  /// When the Member was Deactivated (glossary: Deactivate); `null` while they are active.
  /// Written by the Workspace module, since the plugin can only delete a Member (ADR 0047).
  deactivatedAt DateTime?
  /// When the Account last switched to this Workspace, by choosing it, creating it or accepting an
  /// Invitation to it; `null` until then. Orders a person's Workspaces, the one used last first.
  lastUsedAt    DateTime?

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("member")
}

/// An offer to join a Workspace, written by the plugin's `createInvitation`. `status` is the
/// plugin's lowercase name (`pending`, `accepted`, `canceled`, `rejected`); `role` is the
/// plugin's lowercase Role the inviter chose, `admin` or `member` (#190).
model Invitation {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        String?
  status      String    @default("pending")
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  inviterId   String
  user        User      @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  lastSentAt  DateTime?

  @@index([workspaceId])
  @@index([email])
  @@map("invitation")
}

// Feedback's tables. The Workspace and the people are held as ids with no foreign key into
// Workspace's or Identity's tables: Feedback owns neither, and never joins, transacts or
// migrates across another module's tables (BE_03 R7). The cost is that a deleted Account
// leaves its id behind on an Ask, which the read resolves to no name.

/// ONLY_ME is nobody besides the Giver and the Receiver. The glossary calls it "Only me" when a
/// Requester chooses it and "Only them" when the Giver of Offered Feedback does: one audience.
enum Visibility {
  ONLY_ME
  SELECTED_PEOPLE
  EVERYONE
}

/// Why a piece of Feedback was written (glossary: Requested Feedback, Offered Feedback).
enum FeedbackOrigin {
  REQUESTED
  OFFERED
}

enum AskStatus {
  PENDING
  ANSWERED
  EXPIRED
}

/// A Member asking other Members for Feedback with a Request message (glossary: Feedback Request).
model FeedbackRequest {
  id                 String                          @id
  workspaceId        String
  /// The Account of the Member who asked. They become the Receiver of what it collects.
  requesterAccountId String
  /// What the Requester wrote when asking (glossary: Request message).
  message            String
  /// Who besides the Giver and the Requester reads what it collects. Fixed once sent. The
  /// default only fills rows written before the Requester could choose.
  visibility         Visibility                      @default(ONLY_ME)
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  asks               FeedbackAsk[]
  selectedPeople     FeedbackRequestSelectedPerson[]
  workspaceGoals     FeedbackRequestWorkspaceGoal[]
  mentions           FeedbackRequestMention[]

  @@index([workspaceId, requesterAccountId])
  @@map("feedback_request")
}

/// One Member the Requester chose to read what a request collects, when its Visibility is
/// SELECTED_PEOPLE (glossary: Visibility, Selected people). Personal data: an Account id only.
model FeedbackRequestSelectedPerson {
  feedbackRequestId String
  feedbackRequest   FeedbackRequest @relation(fields: [feedbackRequestId], references: [id], onDelete: Cascade)
  /// The Account of the Member selected. No foreign key: Accounts are Identity's.
  accountId         String

  @@id([feedbackRequestId, accountId])
  @@map("feedback_request_selected_person")
}

/// One Member being asked, inside a Feedback Request (glossary: Ask).
model FeedbackAsk {
  id                String          @id
  feedbackRequestId String
  feedbackRequest   FeedbackRequest @relation(fields: [feedbackRequestId], references: [id], onDelete: Cascade)
  /// The Account of the Member asked to write the Feedback.
  giverAccountId    String
  status            AskStatus       @default(PENDING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  feedback Feedback?

  @@unique([feedbackRequestId, giverAccountId])
  /// For "the Asks waiting for me" (#18), the one read that has no request id.
  @@index([giverAccountId, status])
  @@map("feedback_ask")
}

/// A message from a Giver to a Receiver (glossary: Feedback) — either an answer to an Ask
/// (REQUESTED) or given without being asked (OFFERED), which has no request and no Ask. A CHECK
/// constraint in the migration holds that pairing, which Prisma cannot declare.
model Feedback {
  id                String                   @id
  /// Workspace's id, held without a foreign key (BE_03 R7), as on FeedbackRequest.
  workspaceId       String
  origin            FeedbackOrigin
  /// Set exactly when origin is REQUESTED.
  feedbackRequestId String?
  /// Inside Feedback's own module, so a real relation. One answer per Ask, ever: this unique
  /// index is what refuses a second answer when two requests race, which no check in the
  /// application can do on its own. Set exactly when origin is REQUESTED.
  feedbackAskId     String?                  @unique
  feedbackAsk       FeedbackAsk?             @relation(fields: [feedbackAskId], references: [id], onDelete: Cascade)
  /// The Accounts of the Member who wrote it and the Member it is for. No foreign keys.
  giverAccountId    String
  receiverAccountId String
  /// Who besides the Giver and the Receiver may read it, with the people in selectedPeople.
  /// The Giver's choice for Offered Feedback, the request's copied for Requested. Never changes.
  visibility        Visibility
  /// What the Giver wrote (glossary: Feedback message). A Requested answer carries only its own,
  /// never the request's Request message (brain `ADR-0039`, ADR 0054).
  message           String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  selectedPeople    FeedbackSelectedPerson[]
  workspaceGoals    FeedbackWorkspaceGoal[]
  mentions          FeedbackMention[]

  /// For "the Feedback I received", newest first (#26).
  @@index([workspaceId, receiverAccountId, createdAt])
  /// For "the Feedback I gave" (#27).
  @@index([workspaceId, giverAccountId, createdAt])
  /// For the Workspace feed (#90): everything set to Everyone, newest first. The two indexes
  /// above lead with a person, which that read does not filter on.
  @@index([workspaceId, visibility, createdAt])
  @@map("feedback")
}

/// One Member selected to read one piece of Feedback, when its Visibility is SELECTED_PEOPLE
/// (glossary: Visibility, Selected people) — the Giver's pick for Offered Feedback, the request's
/// copied for Requested. Personal data: an Account id only.
model FeedbackSelectedPerson {
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  /// The Account of the Member selected. No foreign key: Accounts are Identity's.
  accountId  String

  @@id([feedbackId, accountId])
  /// For "Shared with me" (#88): that read starts at the reader, which the primary key's
  /// (feedbackId, accountId) order cannot serve.
  @@index([accountId])
  @@map("feedback_selected_person")
}

/// A Workspace Goal a Request message names (glossary: Workspace Goal), bound when it was sent and
/// never changed — hiding it later leaves this row. The name is the Admin's spelling then, which
/// cannot drift: a Workspace Goal is never renamed. No foreign key: Workspace Goals are not
/// Feedback's (BE_03 R7).
model FeedbackRequestWorkspaceGoal {
  feedbackRequestId String
  feedbackRequest   FeedbackRequest @relation(fields: [feedbackRequestId], references: [id], onDelete: Cascade)
  workspaceGoalId   String
  name              String

  @@id([feedbackRequestId, workspaceGoalId])
  @@map("feedback_request_workspace_goal")
}

/// A Member a Request message mentions (glossary: Mention), bound when it was sent. The slug and
/// the name they went by are kept as they were then, so a read names them without asking Identity.
/// Personal data: an Account id and a display name. No foreign key: Accounts are Identity's.
model FeedbackRequestMention {
  feedbackRequestId String
  feedbackRequest   FeedbackRequest @relation(fields: [feedbackRequestId], references: [id], onDelete: Cascade)
  accountId         String
  slug              String
  displayName       String

  @@id([feedbackRequestId, accountId])
  @@map("feedback_request_mention")
}

/// A Workspace Goal one piece of Feedback names in its Feedback message (glossary: Workspace
/// Goal), bound when it was sent and never changed. An answer has only what its Giver wrote,
/// never the request's. As on FeedbackRequestWorkspaceGoal, the name cannot drift and there is
/// no foreign key.
model FeedbackWorkspaceGoal {
  feedbackId      String
  feedback        Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  workspaceGoalId String
  name            String

  @@id([feedbackId, workspaceGoalId])
  @@map("feedback_workspace_goal")
}

/// A Member one piece of Feedback mentions (glossary: Mention), bound when it was sent. Personal
/// data: an Account id and a display name, kept as they were then. No foreign key.
model FeedbackMention {
  feedbackId  String
  feedback    Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  accountId   String
  slug        String
  displayName String

  @@id([feedbackId, accountId])
  @@map("feedback_mention")
}

// Workspace Goal's table. The Workspace is held as an id with no foreign key into Workspace's
// tables, which this module does not own (BE_03 R7).

/// Whether Members can see and write a Workspace Goal. There is no deleted state (ADR-0036).
enum WorkspaceGoalStatus {
  ACTIVE
  HIDDEN
}

/// A hashtag an Admin creates for the whole Workspace (glossary: Workspace Goal). Never renamed
/// or deleted, only hidden.
model WorkspaceGoal {
  id          String              @id
  workspaceId String
  /// As the Admin wrote it, without the `#`.
  name        String
  /// `name` with letter case folded away. Unique per Workspace, hidden ones included, which is
  /// the rule that two Workspace Goals never differ only in case.
  nameKey     String
  description String?
  status      WorkspaceGoalStatus @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([workspaceId, nameKey])
  @@map("workspace_goal")
}

/// One Workspace's authorised link to one external tool (glossary: Connection). Nothing here is
/// secret for Discord: a server id is known to everyone in it, and a channel id grants nothing on
/// its own. A provider that issues a per-Workspace credential (Slack does) adds the column, the
/// cipher and the key handling together, when they have a reader — design 0020 D3.
model IntegrationConnection {
  id                    String   @id
  /// Workspace's id, held without a foreign key (BE_03 R7), as on FeedbackRequest.
  workspaceId           String
  /// Which external tool, as the provider value the installer registry is keyed by.
  provider              String
  /// The provider's own space: a Discord server, a Slack team. The ids are opaque strings,
  /// because providers do not agree on a shape; the names are held for the screen.
  externalWorkspaceId   String
  externalWorkspaceName String
  externalChannelId     String
  externalChannelName   String
  /// The Account of the Admin who connected it. No foreign key: Accounts are Identity's.
  connectedByAccountId  String
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt

  /// One Connection per Workspace per tool. Carrying the provider means a second tool is not a
  /// migration; the one-per-Workspace rule itself stays in the application layer (design 0020 D7).
  @@unique([workspaceId, provider])
  @@map("integration_connection")
}

// Notifications' table. The Account and the chat tool are held as ids with no foreign key into
// another module's tables (BE_03 R7), as on IntegrationConnection.

/// One Member's own link to their account in a chat tool, which is what lets Thrive message them
/// directly (glossary: Linked Account). Each Member links their own; its existence is their
/// consent, and unlinking is how they stop being messaged (brain ADR-0035 §6).
///
/// No user access token is kept: Thrive messages with its own bot credential, and the token the
/// provider issues at linking is used once, to learn who they are, and discarded (design 0021 D9).
/// Nothing here is a secret — a Discord user id is shown to everyone who shares a server.
model LinkedAccount {
  id               String   @id
  /// The Account this belongs to. No foreign key: Accounts are Identity's.
  accountId        String
  /// Which chat tool, as the provider value the registry is keyed by.
  provider         String
  /// The provider's own space, where it has one — a Slack team. **Empty string, never null**, for
  /// a provider whose user ids stand alone, as Discord's do: Postgres treats NULLs as distinct in
  /// a unique index, so a nullable column would make the second index below silently stop holding
  /// and let two Accounts share one notification stream (design 0021 D8).
  externalTeamId   String
  /// The provider's id for this person.
  externalUserId   String
  /// Shown on their own Settings so they can see which account is linked. Refreshed when linking.
  externalUsername String
  /// The one-to-one conversation with this person, learned the first time Thrive messages them
  /// and reused after — both providers return a stable id for it and both limit how often it may
  /// be opened, and there is no Redis to cache it in (design 0021 D4). Null until a message has
  /// actually arrived: an id from a conversation that then refused the message is not worth
  /// keeping. Not a credential — it grants nothing on its own.
  directChannelId  String?
  linkedAt         DateTime @default(now())
  updatedAt        DateTime @updatedAt

  /// One link per Account per tool: linking again replaces it in place.
  @@unique([accountId, provider])
  /// And one Account per chat-tool identity, so two Members cannot claim the same one.
  @@unique([provider, externalTeamId, externalUserId])
  @@map("linked_account")
}
