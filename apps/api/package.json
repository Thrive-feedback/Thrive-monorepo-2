{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "nest build",
    "contract:generate": "bun scripts/emit-openapi.ts && openapi-typescript openapi.json -o ../../packages/api/src/generated/schema.ts",
    "start": "bun src/main.ts",
    "start:debug": "nest start --debug --watch",
    "start:prod": "bun dist/main",
    "test": "bun test src --path-ignore-patterns='**/*.integration-spec.ts'",
    "test:watch": "bun test --watch src --path-ignore-patterns='**/*.integration-spec.ts'",
    "test:debug": "bun test --inspect-brk src",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "test:integration": "echo 'No integration suite yet. It must be runnable on its own, and bun test cannot select \"*.integration-spec.ts\" by filter — see PROJECT.md §5 decision 1.'",
    "test:bdd": "cucumber-js --config cucumber.cjs",
    "check-arch": "bun scripts/check-architecture.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.11",
    "@nestjs/core": "^11.1.11",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/swagger": "^11.4.7",
    "@scalar/nestjs-api-reference": "^1.2.19",
    "escape-html": "^1.0.3",
    "nestjs-zod": "^5.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@cucumber/cucumber": "^13.2.1",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.11",
    "@repo/biome-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/express": "^4.17.25",
    "@types/node": "catalog:",
    "openapi-typescript": "^7.9.1",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "catalog:"
  }
}
