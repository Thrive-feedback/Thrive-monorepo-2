# Every variable in environment.schema.ts has its line here, added in the same change.
# This is the only env file in git, and it never carries a real secret.
#
# Copy to .env to run the API locally. Every value below is a safe local default.

NODE_ENV=development
PORT=3000

# Local Postgres from compose.yaml. Set distinct least-privilege credentials in deployed environments.
DATABASE_URL=postgresql://thrive:local_only@127.0.0.1:54329/thrive
DATABASE_MIGRATION_URL=postgresql://thrive:local_only@127.0.0.1:54329/thrive

# The origins a browser may call this API from, comma-separated. No default: an empty list
# refuses every cross-origin call, which someone notices at once, where a wrong default
# would survive to production. Add each environment's own origin as it appears.
CORS_ALLOWED_ORIGINS=http://localhost:3001

# Better Auth. The secret must be at least 32 characters; generate one with `openssl rand -base64 32`.
# BETTER_AUTH_URL is the web app's origin, not this API's: the browser reaches Better Auth
# through the web app (ADR 0027).
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001

# The Google OAuth client. Its authorised redirect URI is
# http://localhost:3001/api/auth/callback/google. Real values come from the team's secret store.
GOOGLE_CLIENT_ID=replace-me-with-real-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me-with-real-secret

# Every email is sent for real through Resend's API (ADR 0038), locally too. The From address below
# is the real one — the transport's own, on the subdomain verified in Resend, and not a mailbox
# anyone reads, because Reply-To carries the inviter. Only the key is a placeholder: ask for a
# sending-scoped one from the team's secret store.
RESEND_API_KEY=replace-me-with-a-resend-api-key
RESEND_FROM_ADDRESS=no-reply@mail.thriveteam.app

# Thrive's one Discord application (brain ADR-0035), shared by every Workspace that connects a
# server. The client id is public; the secret and the bot token are not and come from the team's
# secret store. The application's own owner is still an open decision in the brain, so these are
# placeholders everywhere until it is created — the API boots with them and every call to Discord
# is refused, which is what a test fake stands in for.
DISCORD_CLIENT_ID=replace-me-with-the-discord-application-id
DISCORD_CLIENT_SECRET=replace-me-with-the-discord-client-secret
DISCORD_BOT_TOKEN=replace-me-with-the-discord-bot-token
