# Every variable in environment.schema.ts has its line here, added in the same change.
# This is the only env file in git, and it never carries a real secret.
#
# Copy to .env to run the API locally. Every value below is a safe local default.

NODE_ENV=development
PORT=3000

# Directory the file-backed example store writes to. Relative paths resolve from the
# API app's working directory.
TODO_DATA_DIR=.data

# Page sizes for every collection route.
TODO_DEFAULT_PAGE_SIZE=20
TODO_MAX_PAGE_SIZE=100
