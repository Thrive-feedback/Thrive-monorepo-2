# Every variable the web app reads has its line here, added in the same change.
# This is the only env file in git, and it never carries a real secret.
#
# Copy to .env to run the web app locally.

# Where the web server reaches the API. Server-only: it is never NEXT_PUBLIC_, because the
# browser talks to this app alone (ADR 0027).
API_BASE_URL=http://localhost:3000

# Where the postcard templates' files are: the Supabase project's host alone, without https://
# (ADR 0063). Public, because the browser builds each picture's address; not a secret, since
# the bucket is public. Written into the build, so a new value needs a rebuild.
NEXT_PUBLIC_POSTCARD_TEMPLATE_HOST=rygqsihgowwdtakedrxl.supabase.co
