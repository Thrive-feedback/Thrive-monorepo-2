# What the deploy must not upload. The build runs `bun install` for itself, so sending the
# installed tree would mean uploading hundreds of megabytes that the image then discards —
# and the continuous-integration runner has already installed before it deploys.
#
# Keep this aligned with .dockerignore: anything excluded there is useless here too.

node_modules
**/node_modules
.next
**/.next
dist
**/dist
out
**/out
.turbo
**/.turbo
apps/api/src/infrastructure/database/generated

.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

.git
coverage
test-results
**/*.log
.DS_Store
